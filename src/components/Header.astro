---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'בית' },
  { href: '/workshops', label: 'סדנאות פתוחות' },
  { href: '/private', label: 'אירועים פרטיים' },
  { href: '/tracks', label: 'מסלולים' },
  { href: '/recommendations', label: 'המלצות' },
  { href: '/gallery', label: 'גלריה' },
  { href: '/contact', label: 'צור קשר' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="More &amp; Mor">
      <img
        src="/images/LOGOS/1000174508.jpg"
        alt="More &amp; Mor"
        width="1600"
        height="800"
      />
    </a>
    <input id="nav-toggle" class="nav-toggle" type="checkbox" />
    <label class="nav-toggle-label" for="nav-toggle">תפריט</label>
    <nav class="nav" aria-label="ראשי">
      {
        links.map((link) => (
          <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
