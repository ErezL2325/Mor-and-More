---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import { firstImage } from '../lib/media.js';

const teams = firstImage('private/teams');
const bachelorette = firstImage('private/bachelorette');
const family = firstImage('private/family');
const duo = firstImage('private/duo');
const women = firstImage('private/women');
---

<BaseLayout title="אירועים פרטיים | More & Mor" description="סדנאות לגיבוש, מסיבת רווקות, משפחה, זוגי וערב נשים.">
  <div class="wrap page-head">
    <hr class="rule" />
    <h1>אירועים פרטיים</h1>
    <nav class="subnav" aria-label="קהלי אירוע">
      <a href="#teams">ימי גיבוש וכיף לחברות וצוותים</a>
      <a href="#bachelorette">מסיבת רווקות</a>
      <a href="#family">יום הולדת ואירוע משפחתי רב-דורי</a>
      <a href="#duo">דייט זוגי או חוויה עם חברה טובה</a>
      <a href="#women">ערב נשים והפרשת חלה</a>
    </nav>
  </div>

  <article class="wrap block" id="teams">
    <div class="split">
      <Picture src={teams} alt="ימי גיבוש וכיף לחברות וצוותים" />
      <div>
        <h2>ימי גיבוש וכיף לחברות וצוותים</h2>
        <p>יוצאים מהשגרה. ימי גיבוש וחוויה יצירתית לצוות שלכם.</p>
        <p>
          מחפשים דרך מקורית לנקות את הראש, ללכלך קצת את הידיים ולחבר באמת בין אנשים? סדנאות הגבס הפולימרי שלנו
          מציעות שילוב בין יצירה מודרנית, צבע, אנרגיה טובה ואירוח בסטנדרט גבוה. כצוות אנו מביאות איתנו מקצועיות,
          יחס אישי וחמימות משפחתית, כך שגם מי שמעולם לא נגע בחומרי יצירה ירגיש בנוח.
        </p>
        <ul>
          <li>מתאימה לכולם: חוויית יצירה נגישה, זורמת, שבה כולם מצליחים ומפיקים תוצרים לבית או למשרד.</li>
          <li>ראש שקט למארגנים: הדרכה צמודה, חומרי עבודה, ושולחן אירוח עשיר ומפנק.</li>
          <li>
            גמישות: אצלנו בכפר יונה עד 12 משתתפים, או אצלכם במשרד או במתחם באזור השרון והמרכז עד 40 משתתפים.
          </li>
        </ul>
        <a class="btn" href="/tracks">לצפייה במסלולי היצירה, הזמנים והמחירים</a>
      </div>
    </div>
  </article>

  <article class="wrap block" id="bachelorette">
    <div class="split">
      <Picture src={bachelorette} alt="מסיבת רווקות" />
      <div>
        <h2>מסיבת רווקות</h2>
        <p>חוגגות בסטייל: סדנת בוטיק פוטוגנית למסיבת רווקות.</p>
        <p>
          זה הזמן לאסוף את הבנות לחוויה מלאה בסטייל, צחוק, מוזיקה והרבה צבע. סדנת בוטיק אינטימית, קלילה ומלאת
          השראה בגבס פולימרי. כצוות נשי של אמא ובת, נלווה אתכן צעד אחר צעד באווירה משחררת ומחבקת.
        </p>
        <p>הערב מלווה במוזיקה ובכיבוד עשיר. אתן צריכות רק להגיע, להרים כוסית וליהנות מהרגע.</p>
        <ul>
          <li>פסק זמן של צחוק, חיבור וזמן איכות נשי.</li>
          <li>יצירה מעוצבת בטכניקות טרצו ושיש (מארבל).</li>
          <li>מזכרת אישית שכל אחת מכינה בעצמה ולוקחת הביתה.</li>
        </ul>
        <a class="btn" href="/tracks">לצפייה במסלולי היצירה והמחירים למסיבת רווקות</a>
      </div>
    </div>
  </article>

  <article class="wrap block" id="family">
    <div class="split">
      <Picture src={family} alt="יום הולדת ואירוע משפחתי רב-דורי" />
      <div>
        <h2>יום הולדת ואירוע משפחתי רב-דורי</h2>
        <p>חוויה משפחתית רב-דורית: חוגגים יחד סביב שולחן היצירה.</p>
        <p>
          חוגגים יום הולדת עגול, חתונת זהב, או רוצים לאסוף את המשפחה המורחבת לזמן איכות? סביב שולחן היצירה שלנו
          נוצר מפגש רב-דורי. הסדנה מחברת סבים וסבתות, הורים, בני נוער וילדים.
        </p>
        <p>לצד מוזיקה נעימה וכיבוד מפנק נשחק עם פיגמנטים, ניצוק לתבניות, ונצא עם פריטי אומנות ובעיקר עם זיכרון משפחתי.</p>
        <a class="btn" href="/tracks">לצפייה במסלולי היצירה המשפחתיים והמחירים</a>
      </div>
    </div>
  </article>

  <article class="wrap block" id="duo">
    <div class="split">
      <Picture src={duo} alt="דייט זוגי או חוויה עם חברה טובה" />
      <div>
        <h2>דייט זוגי או חוויה עם חברה טובה</h2>
        <p>זמן איכות אמיתי: סדנת בוטיק פרטית ואינטימית בשניים.</p>
        <p>
          מחפשים לצאת מהשגרה של סרט ומסעדה? רוצה להפתיע את החברה הכי טובה שלך בחוויה יצירתית שכולה רק שלכן?
        </p>
        <p>
          זמן איכות זוגי או חברי, באווירה רגועה, מעוררת השראה ובגובה העיניים. הסדנה הפרטית מתקיימת בכפר יונה: שקט,
          מוזיקה, יצירה, והנאה מהדרך.
        </p>
        <p>הסדנה כוללת שולחן כיבוד עשיר ומלווה ביין משובח.</p>
        <ul>
          <li>פרטיות מלאה, עם הדרכה צמודה ואישית של שתינו לאורך כל השלבים.</li>
          <li>עבודה עם גבס פולימרי, פיגמנטים, וכלים מעוצבים.</li>
          <li>בסיום יוצאים עם פריטים מעוצבים לבית.</li>
        </ul>
        <a class="btn" href="/tracks">לצפייה במסלולי היצירה, הזמנים והמחירים</a>
      </div>
    </div>
  </article>

  <article class="wrap block" id="women">
    <div class="split">
      <Picture src={women} alt="ערב נשים והפרשת חלה" />
      <div>
        <h2>ערב נשים והפרשת חלה</h2>
        <p>חיבור, אנרגיה ואומנות: ערב נשים וחוויה.</p>
        <p>
          רוצה לשדרג את ערב הפרשת החלה? מחפשת דרך לחגוג יום הולדת נשי או לארגן ערב לחברות קרובות, בנות משפחה או
          שכנות?
        </p>
        <p>
          שילוב בין אנרגיה נשית, מסורת ואומנות מודרנית. כזוג מנחות, אמא ובת, מביאות לערב לב, אסתטיקה, אנרגיה טובה
          וחום משפחתי.
        </p>
        <p>נשלב סדנת יצירה בגבס פולימרי. כל משתתפת יוצאת עם תוצר אישי.</p>
        <ul>
          <li>התאמה ללוח הזמנים שלכן: הסדנה משתלבת עם טקס הפרשת החלה או הברכות של הערב.</li>
          <li>הדרכה שמתאימה לכולן.</li>
          <li>מגיעות עם הציוד, הסינרים והחומרים עד הבית או מקום האירוע, באזור השרון והמרכז.</li>
        </ul>
        <a class="btn" href="/tracks">לצפייה במסלולי היצירה והמחירים לאירוע</a>
      </div>
    </div>
  </article>
</BaseLayout>
