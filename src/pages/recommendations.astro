---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listImages } from '../lib/media.js';

const images = listImages('recommendations');
---

<BaseLayout title="המלצות | More & Mor">
  <div class="wrap quote-wrap">
    <hr class="rule rule-center" />
    <blockquote>את השלמות הזאת לא קניתי. את השלמות הזאת יצרנו במו ידינו, אמה ואני.</blockquote>
  </div>

  <div class="wrap section">
    {
      images.length === 0 ? (
        <div class="gallery-grid">
          {Array.from({ length: 6 }).map(() => (
            <div class="ph">תמונה תוחלף</div>
          ))}
        </div>
      ) : (
        <div class="gallery-grid contains">
          {images.map((src) => (
            <img src={src} alt="המלצה" loading="lazy" />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
