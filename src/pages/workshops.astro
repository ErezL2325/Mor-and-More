---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import { firstImage } from '../lib/media.js';

const gypsum = firstImage('workshops/gypsum');
const candles = firstImage('workshops/candles');
---

<BaseLayout title="סדנאות פתוחות | More & Mor" description="סדנת גבס פולימרי וסדנת יציקת נרות משעווה טבעית בכפר יונה.">
  <div class="wrap page-head">
    <hr class="rule" />
    <h1>סדנאות פתוחות</h1>
    <p class="lead">
      מחפשים חוויה זורמת, פסק זמן מהשגרה ומפגש פתוח עם אנשים חדשים? בחרו את הסדנה שמתחשק לכם להתנסות בה, שריינו
      מקום בלוח התאריכים ובואו ליצור.
    </p>
  </div>

  <article class="wrap workshop">
    <Picture src={gypsum} alt="סדנת יצירה ועיצוב בגבס פולימרי" />
    <div>
      <h2>סדנת יצירה ועיצוב בגבס פולימרי</h2>
      <p>
        במהלך הסדנה נכיר את הגבס הפולימרי, נשחק עם פיגמנטים וצבעים, ונתנסה בשתי טכניקות עיצוב: טרצו ושיש (מארבל).
        כל משתתף בוחר בעצמו את הכלים שירצה להכין מתוך מבחר גדול של שבלונות ועיצובים. בסיום, כל אחד יוצא הביתה עם 3
        כלים מעוצבים בעבודת יד שהוא יצר בעצמו.
      </p>
      <ul class="meta">
        <li>משך: כ-3.5 שעות.</li>
        <li>כלול: הדרכה צמודה, כל חומרי העבודה, כיבוד עשיר ומפנק, ו-3 הכלים שעיצבתם.</li>
        <li>עלות: 350 ₪ לאדם.</li>
        <li>הנחת קבוצות חברות: 4 משתתפים ומעלה 340 ₪ למשתתף. 8 משתתפים ומעלה 330 ₪ למשתתף.</li>
      </ul>
      <a class="btn" href="/contact?type=open">לצפייה בתאריכים הקרובים והרשמה</a>
    </div>
  </article>

  <article class="wrap workshop">
    <Picture src={candles} alt="סדנת יציקת נרות משעווה טבעית" />
    <div>
      <h2>סדנת יציקת נרות משעווה טבעית</h2>
      <p>
        חוויה חושית ומנתקת שמערבת את כל החושים. בסדנה זו נלמד לעצב 2 כלים לסט נרות בטכניקת מרבל (שיש). לאחר מכן
        ניצוק לתוך הכלים שיצרתן בעצמכן נרות ריחניים משעוות סויה טבעית 100%, בשילוב תמציות ניחוח ושמנים אתריים
        איכותיים.
      </p>
      <ul class="meta">
        <li>משך: כ-3.5 שעות.</li>
        <li>כלול: הדרכה צמודה, שעוות סויה, תמציות ריח, חומרי יצירה לגבס, וכיבוד עשיר ומפנק.</li>
        <li>עלות: <span class="missing">[חסר: מחיר סדנת הנרות. לא להעתיק 350 מסדנת הגבס.]</span></li>
      </ul>
      <a class="btn" href="/contact?type=open">לצפייה בתאריכים הקרובים והרשמה</a>
    </div>
  </article>
</BaseLayout>
